diff --git a/tests/test_result_memoization.py b/tests/test_result_memoization.py
new file mode 100644
index 0000000..b8136a3
--- /dev/null
+++ b/tests/test_result_memoization.py
@@ -0,0 +1,127 @@
+"""Contract coverage for reusable workflow step results."""
+
+import asyncio
+
+import pytest
+
+from basalt.core.dag.ast import DAGSpec, ExecutorType, MemoizationPolicySpec, StepSpec
+from basalt.core.engine.hooks import HookRegistry, LifecycleEvent
+from basalt.core.engine.memoization import ResultCache, make_cache_key
+from basalt.core.engine.runner import WorkflowRunner
+from basalt.core.executors.base import BaseExecutor
+from basalt.core.executors.pool import ExecutorFactory, WorkerPool
+
+
+class Counter(BaseExecutor):
+    def __init__(self):
+        super().__init__("custom")
+        self.calls = 0
+
+    async def execute(self, step, context):
+        self.calls += 1
+        return {"call": self.calls, "input": context.inputs.get("value")}
+
+
+def runner(counter=None, hooks=None, cache=None):
+    counter = counter or Counter()
+    factory = ExecutorFactory()
+    factory.register("custom", counter)
+    return WorkflowRunner(WorkerPool(factory=factory), hooks or HookRegistry(), cache), counter
+
+
+def dag(policy=None, depends=False, key="shared"):
+    first = StepSpec(id="work", executor_type=ExecutorType.CUSTOM,
+        memoization=policy or MemoizationPolicySpec(enabled=True, key=key))
+    steps = [first]
+    if depends:
+        steps.append(StepSpec(id="after", executor_type=ExecutorType.CUSTOM, depends_on=["work"]))
+    return DAGSpec(id="memo_dag", steps=steps)
+
+
+def test_memo_policy_defaults_disabled():
+    assert MemoizationPolicySpec().enabled is False
+
+def test_memo_policy_accepts_ttl():
+    assert MemoizationPolicySpec(enabled=True, ttl_seconds=1).ttl_seconds == 1
+
+def test_cache_key_is_stable_for_same_context():
+    from basalt.core.engine.context import ExecutionContext
+    step = dag().steps[0]
+    assert make_cache_key(step, ExecutionContext("a", "memo_dag", {"x": 1})) == make_cache_key(step, ExecutionContext("b", "memo_dag", {"x": 1}))
+
+def test_cache_key_changes_when_inputs_change():
+    from basalt.core.engine.context import ExecutionContext
+    step = dag().steps[0]
+    assert make_cache_key(step, ExecutionContext("a", "memo_dag", {"x": 1})) != make_cache_key(step, ExecutionContext("a", "memo_dag", {"x": 2}))
+
+@pytest.mark.asyncio
+async def test_result_cache_put_and_get():
+    cache = ResultCache(); await cache.put("a", {"x": 1}); assert await cache.get("a") == {"x": 1}
+
+@pytest.mark.asyncio
+async def test_result_cache_returns_copies():
+    cache = ResultCache(); await cache.put("a", {"x": []}); out = await cache.get("a"); out["x"].append(1); assert await cache.get("a") == {"x": []}
+
+@pytest.mark.asyncio
+async def test_result_cache_invalidates_entry():
+    cache = ResultCache(); await cache.put("a", {}); assert await cache.invalidate("a"); assert await cache.get("a") is None
+
+@pytest.mark.asyncio
+async def test_result_cache_clear_reports_count():
+    cache = ResultCache(); await cache.put("a", {}); await cache.put("b", {}); assert await cache.clear() == 2
+
+@pytest.mark.asyncio
+async def test_result_cache_expires_entries():
+    cache = ResultCache(); await cache.put("a", {}, 0.001); await asyncio.sleep(0.01); assert await cache.get("a") is None
+
+@pytest.mark.asyncio
+async def test_result_cache_stats_track_hits_and_misses():
+    cache = ResultCache(); await cache.get("missing"); await cache.put("a", {}); await cache.get("a"); assert (await cache.stats())["hits"] == 1
+
+@pytest.mark.asyncio
+async def test_enabled_step_reuses_result_across_runs():
+    r, count = runner(); await r.run_async(dag(), {"value": 1}); second = await r.run_async(dag(), {"value": 1}); assert count.calls == 1 and second.outputs["work"]["call"] == 1
+
+@pytest.mark.asyncio
+async def test_disabled_step_always_executes():
+    r, count = runner(); d = dag(MemoizationPolicySpec(enabled=False)); await r.run_async(d); await r.run_async(d); assert count.calls == 2
+
+@pytest.mark.asyncio
+async def test_changed_inputs_miss_cache():
+    r, count = runner(); await r.run_async(dag(), {"value": 1}); await r.run_async(dag(), {"value": 2}); assert count.calls == 2
+
+@pytest.mark.asyncio
+async def test_include_inputs_false_reuses_across_inputs():
+    r, count = runner(); d = dag(MemoizationPolicySpec(enabled=True, key="x", include_inputs=False)); await r.run_async(d, {"value": 1}); await r.run_async(d, {"value": 2}); assert count.calls == 1
+
+@pytest.mark.asyncio
+async def test_changed_key_is_a_different_cache_namespace():
+    r, count = runner(); await r.run_async(dag(key="one")); await r.run_async(dag(key="two")); assert count.calls == 2
+
+@pytest.mark.asyncio
+async def test_ttl_expiry_executes_again():
+    r, count = runner(); d = dag(MemoizationPolicySpec(enabled=True, key="ttl", ttl_seconds=.001)); await r.run_async(d); await asyncio.sleep(.01); await r.run_async(d); assert count.calls == 2
+
+@pytest.mark.asyncio
+async def test_cache_hit_emits_lifecycle_event():
+    seen=[]; hooks=HookRegistry(); hooks.register(LifecycleEvent.STEP_CACHE_HIT, lambda e,c,p: seen.append(p)); r,_ = runner(hooks=hooks); await r.run_async(dag()); await r.run_async(dag()); assert seen[0]["step_id"] == "work"
+
+@pytest.mark.asyncio
+async def test_cache_hit_success_payload_marks_cached():
+    seen=[]; hooks=HookRegistry(); hooks.register(LifecycleEvent.STEP_SUCCESS, lambda e,c,p: seen.append(p)); r,_ = runner(hooks=hooks); await r.run_async(dag()); await r.run_async(dag()); assert seen[-1]["cached"] is True
+
+@pytest.mark.asyncio
+async def test_cached_parent_allows_dependent_step():
+    r, count = runner(); d=dag(depends=True); await r.run_async(d); out=await r.run_async(d); assert out.outputs["after"] and count.calls == 3
+
+@pytest.mark.asyncio
+async def test_cache_can_be_shared_between_runners():
+    cache=ResultCache(); one,counter=runner(cache=cache); two,_=runner(counter=counter, cache=cache); await one.run_async(dag()); await two.run_async(dag()); assert counter.calls == 1
+
+@pytest.mark.asyncio
+async def test_failed_work_is_not_cached():
+    class Bad(Counter):
+        async def execute(self, step, context):
+            self.calls += 1
+            raise RuntimeError("no")
+    r, count=runner(Bad()); await r.run_async(dag()); await r.run_async(dag()); assert count.calls == 2

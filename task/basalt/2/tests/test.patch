+"""Focused behavioral tests for opt-in workflow result memoization."""
+
+import asyncio
+from typing import Any
+
+import pytest
+
+from basalt.core.dag.ast import DAGSpec, ExecutorType, MemoizationPolicySpec, StepSpec
+from basalt.core.engine.memoization import ResultCache
+from basalt.core.engine.runner import WorkflowRunner
+from basalt.core.executors.base import BaseExecutor
+from basalt.core.executors.pool import ExecutorFactory, WorkerPool
+
+
+class CountingExecutor(BaseExecutor):
+    """Executor whose call count makes cache hits observable."""
+    def __init__(self, fail: bool = False) -> None:
+        super().__init__("custom")
+        self.calls = 0
+        self.fail = fail
+
+    async def execute(self, step: StepSpec, context: Any) -> dict[str, Any]:
+        self.calls += 1
+        if self.fail:
+            raise RuntimeError("expected failure")
+        return {"call": self.calls, "value": context.inputs.get("value")}
+
+
+def make_runner(executor=None, cache=None):
+    """Create an isolated runner and its observable executor."""
+    actual = executor or CountingExecutor()
+    factory = ExecutorFactory()
+    factory.register("custom", actual)
+    return WorkflowRunner(worker_pool=WorkerPool(factory=factory), result_cache=cache), actual
+
+
+def make_dag(enabled=True, key="shared", include_inputs=True, ttl_seconds=None):
+    """Build a single-step memoized workflow."""
+    policy = MemoizationPolicySpec(enabled=enabled, key=key,
+        include_inputs=include_inputs, ttl_seconds=ttl_seconds)
+    step = StepSpec(id="work", executor_type=ExecutorType.CUSTOM, memoization=policy)
+    return DAGSpec(id="memo_workflow", steps=[step])
+
+
+def test_memoization_is_disabled_by_default():
+    assert MemoizationPolicySpec().enabled is False
+
+
+def test_memoization_policy_exposes_expected_defaults():
+    policy = MemoizationPolicySpec()
+    assert (policy.key, policy.ttl_seconds, policy.include_inputs) == (None, None, True)
+
+

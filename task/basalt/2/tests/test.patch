+"""Additional contract coverage for the public ResultCache surface.
+
+This module validates detailed boundary contracts for ResultCache methods,
+key namespace management, statistics isolation, and workflow interaction.
+"""
+
+import asyncio
+from typing import Any
+
+import pytest
+
+from basalt.core.dag.ast import DAGSpec, ExecutorType, MemoizationPolicySpec, StepSpec
+from basalt.core.engine.hooks import HookRegistry, LifecycleEvent
+from basalt.core.engine.memoization import ResultCache
+from basalt.core.engine.runner import WorkflowRunner
+from basalt.core.executors.base import BaseExecutor
+from basalt.core.executors.pool import ExecutorFactory, WorkerPool
+
+
+class DedicatedWorker(BaseExecutor):
+    """Worker recording execution sequence and arguments."""
+
+    def __init__(self) -> None:
+        super().__init__("custom")
+        self.invocation_count: int = 0
+        self.history: list[dict[str, Any]] = []
+
+    async def execute(self, step: StepSpec, context: Any) -> dict[str, Any]:
+        self.invocation_count += 1
+        output = {
+            "index": self.invocation_count,
+            "step_name": step.id,
+            "params": step.parameters.copy() if step.parameters else {},
+        }
+        self.history.append(output)
+        return output
+
+
+@pytest.mark.asyncio
+async def test_keys_only_lists_live_entries() -> None:
+    """Verify that keys() reports only non-expired live cache keys."""
+    cache = ResultCache()
+    await cache.put("persistent_key", {"status": "persists"})
+    await cache.put("fleeting_key", {"status": "vanishes"}, ttl_seconds=0.01)
+
+    await asyncio.sleep(0.1)
+    active_keys = await cache.keys()
+
+    assert active_keys == ["persistent_key"]
+
+
+@pytest.mark.asyncio
+async def test_invalidate_missing_key_reports_false() -> None:
+    """Verify that invalidating a non-existent key returns False."""
+    cache = ResultCache()
+    result = await cache.invalidate("non_existent_key")
+    assert result is False
+
+
+@pytest.mark.asyncio
+async def test_clear_leaves_zero_entries() -> None:
+    """Verify that clear() resets all stored cache entries to zero."""
+    cache = ResultCache()
+    await cache.put("item_alpha", {"val": 1})
+    await cache.put("item_beta", {"val": 2})
+
+    total_removed = await cache.clear()
+
+    assert total_removed == 2
+    assert await cache.keys() == []
+    stats = await cache.stats()
+    assert stats == {"entries": 0, "hits": 0, "misses": 0}
+
+
+@pytest.mark.asyncio
+async def test_result_cache_overwriting_existing_key() -> None:
+    """Verify that storing a new value for an existing key updates the cache entry."""
+    cache = ResultCache()
+    await cache.put("shared_key", {"generation": 1})
+    first_read = await cache.get("shared_key")
+    assert first_read == {"generation": 1}
+
+    await cache.put("shared_key", {"generation": 2})
+    second_read = await cache.get("shared_key")
+    assert second_read == {"generation": 2}
+
+    stats = await cache.stats()
+    assert stats["entries"] == 1
+
+
+@pytest.mark.asyncio
+async def test_result_cache_deep_copy_isolation_nested_structures() -> None:
+    """Verify that complex nested lists and dicts remain completely isolated."""
+    cache = ResultCache()
+    complex_data = {
+        "metadata": {"version": 1, "tags": ["a", "b"]},
+        "records": [{"id": 101, "scores": [95, 88]}],
+    }
+
+    await cache.put("complex_key", complex_data)
+    complex_data["metadata"]["tags"].append("c")
+    complex_data["records"][0]["scores"].append(100)
+
+    stored = await cache.get("complex_key")
+    assert stored["metadata"]["tags"] == ["a", "b"]
+    assert stored["records"][0]["scores"] == [95, 88]
+
+
+@pytest.mark.asyncio
+async def test_result_cache_stats_hit_miss_counter_accuracy() -> None:
+    """Verify that hits and misses increment monotonically with each operation."""
+    cache = ResultCache()
+
+    for idx in range(3):
+        await cache.get(f"missing_{idx}")
+
+    await cache.put("present_key", {"value": 42})
+
+    for _ in range(5):
+        await cache.get("present_key")
+
+    stats = await cache.stats()
+    assert stats["entries"] == 1
+    assert stats["misses"] == 3
+    assert stats["hits"] == 5
+
+
+@pytest.mark.asyncio
+async def test_result_cache_concurrent_operations() -> None:
+    """Verify thread-safe concurrent reads and writes on the ResultCache."""
+    cache = ResultCache()
+
+    async def writer_task(key: str, val: int) -> None:
+        for offset in range(5):
+            await cache.put(f"{key}_{offset}", {"data": val + offset})
+
+    async def reader_task(key: str) -> None:
+        for offset in range(5):
+            await cache.get(f"{key}_{offset}")
+
+    tasks = [
+        writer_task("part_a", 10),
+        writer_task("part_b", 20),
+        reader_task("part_a"),
+        reader_task("part_b"),
+    ]
+    await asyncio.gather(*tasks)
+
+    live_keys = await cache.keys()
+    assert len(live_keys) == 10
+

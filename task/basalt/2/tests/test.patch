+@pytest.mark.asyncio
+async def test_cache_hit_skips_step_start_lifecycle_event() -> None:
+    """Verify that a cache hit skips invoking the step executor and does not emit STEP_START."""
+    event_counts: dict[LifecycleEvent, int] = {
+        LifecycleEvent.STEP_START: 0,
+        LifecycleEvent.STEP_CACHE_HIT: 0,
+        LifecycleEvent.STEP_SUCCESS: 0,
+    }
+    hooks = HookRegistry()
+    for event_type in event_counts:
+        hooks.register(
+            event_type,
+            lambda event, context, payload, et=event_type: event_counts.__setitem__(
+                et, event_counts[et] + 1
+            ),
+        )
+
+    runner_instance, counter = create_test_runner(hooks=hooks)
+    dag_spec = build_test_dag()
+
+    # Initial execution: cache miss, STEP_START is emitted
+    await runner_instance.run_async(dag_spec)
+    assert counter.calls == 1
+    assert event_counts[LifecycleEvent.STEP_START] == 1
+    assert event_counts[LifecycleEvent.STEP_CACHE_HIT] == 0
+    assert event_counts[LifecycleEvent.STEP_SUCCESS] == 1
+
+    # Second execution: cache hit, STEP_START must be skipped and not emitted
+    await runner_instance.run_async(dag_spec)
+    assert counter.calls == 1
+    assert event_counts[LifecycleEvent.STEP_START] == 1
+    assert event_counts[LifecycleEvent.STEP_CACHE_HIT] == 1
+    assert event_counts[LifecycleEvent.STEP_SUCCESS] == 2
+

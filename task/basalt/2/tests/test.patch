+@pytest.mark.asyncio
+async def test_result_cache_multiple_clears_idempotent() -> None:
+    """Verify that calling clear on an already empty cache returns zero."""
+    cache = ResultCache()
+    first_clear = await cache.clear()
+    assert first_clear == 0
+
+    await cache.put("temp_item", {"x": 10})

+    captured_events: list[tuple[Any, dict[str, Any]]] = []
+    hooks = HookRegistry()
+    for event_type in (LifecycleEvent.STEP_CACHE_HIT, LifecycleEvent.STEP_SUCCESS):
+        hooks.register(

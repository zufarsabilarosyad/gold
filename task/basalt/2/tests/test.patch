+def test_memoization_policy_spec_equality_and_copies() -> None:
+    """Verify that MemoizationPolicySpec supports equality comparisons."""
+    policy_a = MemoizationPolicySpec(enabled=True, key="common", ttl_seconds=10.0, include_inputs=True)
+    policy_b = MemoizationPolicySpec(enabled=True, key="common", ttl_seconds=10.0, include_inputs=True)
+    policy_c = MemoizationPolicySpec(enabled=True, key="different", ttl_seconds=10.0, include_inputs=True)
+
+    assert policy_a == policy_b

+"""Contract coverage for reusable workflow step results."""
+
+import asyncio
+import pytest
+
+from basalt.core.dag.ast import DAGSpec, ExecutorType, MemoizationPolicySpec, StepSpec
+from basalt.core.engine.hooks import HookRegistry, LifecycleEvent
+from basalt.core.engine.memoization import ResultCache
+from basalt.core.engine.runner import WorkflowRunner
+from basalt.core.executors.base import BaseExecutor
+from basalt.core.executors.pool import ExecutorFactory, WorkerPool
+
+
+class Counter(BaseExecutor):
+    def __init__(self):
+        super().__init__("custom")
+        self.calls = 0
+
+    async def execute(self, step, context):
+        self.calls += 1
+        return {"call": self.calls, "input": context.inputs.get("value")}
+
+
+def runner(counter=None, hooks=None, cache=None):
+    counter = counter or Counter()
+    factory = ExecutorFactory()
+    factory.register("custom", counter)
+    return WorkflowRunner(WorkerPool(factory=factory), hooks or HookRegistry(), cache), counter
+
+
+def dag(policy=None, depends=False, key="shared"):
+    first = StepSpec(
+        id="work",
+        executor_type=ExecutorType.CUSTOM,
+        memoization=policy or MemoizationPolicySpec(enabled=True, key=key),
+    )
+    steps = [first]
+    if depends:
+        steps.append(StepSpec(id="after", executor_type=ExecutorType.CUSTOM, depends_on=["work"]))
+    return DAGSpec(id="memo_dag", steps=steps)
+
+
+def test_memo_policy_defaults_disabled():
+    policy = MemoizationPolicySpec()
+    assert policy.enabled is False
+    assert policy.key is None
+    assert policy.ttl_seconds is None
+    assert policy.include_inputs is True
+
+
+def test_memo_policy_rejects_nonpositive_ttl():
+    with pytest.raises(ValueError):
+        MemoizationPolicySpec(enabled=True, ttl_seconds=0)
+    with pytest.raises(ValueError):
+        MemoizationPolicySpec(enabled=True, ttl_seconds=-1.0)
+
+
+@pytest.mark.asyncio
+async def test_executable_definition_changes_cache_identity():
+    runner_instance, counter = runner()
+    first_dag = dag()
+    second_dag = dag()
+    first_dag.steps[0].parameters = {"version": 1}
+    second_dag.steps[0].parameters = {"version": 2}
+    await runner_instance.run_async(first_dag)
+    await runner_instance.run_async(second_dag)
+    assert counter.calls == 2
+
+
+@pytest.mark.asyncio
+async def test_dependency_output_changes_cache_identity():
+    runner_instance, counter = runner()
+    child_policy = MemoizationPolicySpec(enabled=True, key="child", include_inputs=False)
+    graph = DAGSpec(
+        id="deps",
+        steps=[
+            StepSpec(id="parent", executor_type=ExecutorType.CUSTOM),
+            StepSpec(
+                id="child",
+                executor_type=ExecutorType.CUSTOM,
+                depends_on=["parent"],
+                memoization=child_policy,
+            ),
+        ],
+    )
+    await runner_instance.run_async(graph, {"value": 1})
+    await runner_instance.run_async(graph, {"value": 2})
+    assert counter.calls == 4
+
+
+@pytest.mark.asyncio
+async def test_result_cache_put_and_get():
+    cache = ResultCache()
+    await cache.put("a", {"x": 1})
+    assert await cache.get("a") == {"x": 1}
+
+
+@pytest.mark.asyncio
+async def test_result_cache_returns_copies():
+    cache = ResultCache()
+    original_input = {"x": []}
+    await cache.put("a", original_input)
+    original_input["x"].append(2)
+    assert await cache.get("a") == {"x": []}
+    retrieved = await cache.get("a")
+    retrieved["x"].append(1)
+    assert await cache.get("a") == {"x": []}
+
+
+@pytest.mark.asyncio
+async def test_result_cache_invalidates_entry():
+    cache = ResultCache()
+    await cache.put("a", {"status": "ok"})
+    assert await cache.invalidate("a") is True
+    assert await cache.get("a") is None
+
+
+@pytest.mark.asyncio
+async def test_result_cache_clear_reports_count():
+    cache = ResultCache()
+    await cache.put("a", {})
+    await cache.put("b", {})
+    assert await cache.clear() == 2
+    assert await cache.get("a") is None
+    assert await cache.get("b") is None
+
+
+@pytest.mark.asyncio
+async def test_result_cache_expires_entries():
+    cache = ResultCache()
+    await cache.put("a", {"data": 1}, ttl_seconds=0.001)
+    await asyncio.sleep(0.01)
+    assert await cache.get("a") is None
+
+
+@pytest.mark.asyncio
+async def test_result_cache_stats_track_hits_and_misses():
+    cache = ResultCache()
+    await cache.get("missing")
+    await cache.put("a", {})
+    await cache.get("a")
+    assert await cache.stats() == {"entries": 1, "hits": 1, "misses": 1}
+
+
+@pytest.mark.asyncio
+async def test_enabled_step_reuses_result_across_runs():
+    runner_instance, counter = runner()
+    d = dag()
+    await runner_instance.run_async(d, {"value": 1})
+    second_run = await runner_instance.run_async(d, {"value": 1})
+    assert counter.calls == 1
+    assert second_run.outputs["work"]["call"] == 1
+
+
+@pytest.mark.asyncio
+async def test_disabled_step_always_executes():
+    runner_instance, counter = runner()
+    d = dag(MemoizationPolicySpec(enabled=False))
+    await runner_instance.run_async(d)
+    await runner_instance.run_async(d)
+    assert counter.calls == 2
+
+
+@pytest.mark.asyncio
+async def test_changed_inputs_miss_cache():
+    runner_instance, counter = runner()
+    d = dag()
+    await runner_instance.run_async(d, {"value": 1})
+    await runner_instance.run_async(d, {"value": 2})
+    assert counter.calls == 2
+
+
+@pytest.mark.asyncio
+async def test_include_inputs_false_reuses_across_inputs():
+    runner_instance, counter = runner()
+    d = dag(MemoizationPolicySpec(enabled=True, key="x", include_inputs=False))
+    await runner_instance.run_async(d, {"value": 1})
+    await runner_instance.run_async(d, {"value": 2})
+    assert counter.calls == 1
+
+
+@pytest.mark.asyncio
+async def test_changed_key_is_a_different_cache_namespace():
+    runner_instance, counter = runner()
+    await runner_instance.run_async(dag(key="one"))
+    await runner_instance.run_async(dag(key="two"))
+    assert counter.calls == 2
+
+
+@pytest.mark.asyncio
+async def test_ttl_expiry_executes_again():
+    runner_instance, counter = runner()
+    d = dag(MemoizationPolicySpec(enabled=True, key="ttl", ttl_seconds=0.001))
+    await runner_instance.run_async(d)
+    await asyncio.sleep(0.01)
+    await runner_instance.run_async(d)
+    assert counter.calls == 2
+
+
+@pytest.mark.asyncio
+async def test_cache_hit_emits_lifecycle_event():
+    seen = []
+    hooks = HookRegistry()
+    hooks.register(LifecycleEvent.STEP_CACHE_HIT, lambda e, c, p: seen.append((e, p)))
+    runner_instance, _ = runner(hooks=hooks)
+    await runner_instance.run_async(dag())
+    await runner_instance.run_async(dag())
+    assert len(seen) >= 1
+    event, payload = seen[0]
+    assert event == LifecycleEvent.STEP_CACHE_HIT
+    assert set(payload.keys()) == {"step_id", "cache_key", "output"}
+    assert payload["step_id"] == "work"
+    assert isinstance(payload["cache_key"], str) and len(payload["cache_key"]) > 0
+
+
+@pytest.mark.asyncio
+async def test_cache_hit_success_payload_marks_cached():
+    seen = []
+    hooks = HookRegistry()
+    for event in (LifecycleEvent.STEP_CACHE_HIT, LifecycleEvent.STEP_SUCCESS):
+        hooks.register(event, lambda e, c, p: seen.append((e, p)))
+    runner_instance, _ = runner(hooks=hooks)
+    await runner_instance.run_async(dag())
+    assert seen[-1][1]["cached"] is False
+    seen.clear()
+    await runner_instance.run_async(dag())
+    events = [event for event, _ in seen]
+    assert events == [LifecycleEvent.STEP_CACHE_HIT, LifecycleEvent.STEP_SUCCESS]
+    assert seen[-1][1] == {"step_id": "work", "output": {"call": 1, "input": None}, "cached": True}
+
+
+@pytest.mark.asyncio
+async def test_cached_parent_allows_dependent_step():
+    runner_instance, counter = runner()
+    d = dag(depends=True)
+    await runner_instance.run_async(d)
+    out = await runner_instance.run_async(d)
+    assert out.outputs["after"] is not None
+    assert counter.calls == 3
+
+
+@pytest.mark.asyncio
+async def test_cache_can_be_shared_between_runners():
+    cache = ResultCache()
+    first_runner, counter = runner(cache=cache)
+    second_runner, _ = runner(counter=counter, cache=cache)
+    await first_runner.run_async(dag())
+    await second_runner.run_async(dag())
+    assert counter.calls == 1
+
+
+@pytest.mark.asyncio
+async def test_failed_work_is_not_cached():
+    class FailingExecutor(Counter):
+        async def execute(self, step, context):
+            self.calls += 1
+            raise RuntimeError("Step failed intentionally")
+
+    runner_instance, counter = runner(FailingExecutor())
+    await runner_instance.run_async(dag())
+    await runner_instance.run_async(dag())
+    assert counter.calls == 2

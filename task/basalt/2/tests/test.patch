+"""Focused tests for the public asynchronous ResultCache API."""
+
+import asyncio
+
+import pytest
+
+from basalt.core.engine.memoization import ResultCache
+
+
+@pytest.mark.asyncio
+async def test_cache_miss_returns_none():
+    assert await ResultCache().get("missing") is None
+
+
+@pytest.mark.asyncio
+async def test_cache_put_then_get_returns_output():
+    cache = ResultCache()
+    await cache.put("key", {"answer": 42})
+    assert await cache.get("key") == {"answer": 42}
+
+
+@pytest.mark.asyncio
+async def test_cache_outputs_are_isolated_copies():
+    cache = ResultCache()
+    original = {"items": [1]}
+    await cache.put("key", original)
+    original["items"].append(2)
+    received = await cache.get("key")
+    received["items"].append(3)
+    assert await cache.get("key") == {"items": [1]}
+
+
+@pytest.mark.asyncio
+async def test_cache_invalidate_reports_removal():
+    cache = ResultCache()
+    await cache.put("key", {})
+    assert await cache.invalidate("key") is True
+    assert await cache.invalidate("key") is False
+
+
+@pytest.mark.asyncio
+async def test_cache_clear_returns_removed_count():
+    cache = ResultCache()
+    await cache.put("one", {})
+    await cache.put("two", {})
+    assert await cache.clear() == 2
+    assert await cache.get("one") is None
+
+
+@pytest.mark.asyncio
+async def test_cache_keys_lists_live_entries():
+    cache = ResultCache()
+    await cache.put("one", {})
+    await cache.put("two", {})
+    assert set(await cache.keys()) == {"one", "two"}
+
+
+@pytest.mark.asyncio
+async def test_cache_stats_reports_entries_hits_and_misses():
+    cache = ResultCache()
+    await cache.get("missing")
+    await cache.put("one", {})
+    await cache.get("one")
+    assert await cache.stats() == {"entries": 1, "hits": 1, "misses": 1}
+
+
+@pytest.mark.asyncio
+async def test_cache_ttl_expires_entry():
+    cache = ResultCache()
+    await cache.put("short", {"old": True}, ttl_seconds=0.001)
+    await asyncio.sleep(0.01)
+    assert await cache.get("short") is None
+
+
+@pytest.mark.asyncio
+async def test_cache_overwrites_existing_key():
+    cache = ResultCache()
+    await cache.put("key", {"version": 1})
+    await cache.put("key", {"version": 2})
+    assert await cache.get("key") == {"version": 2}
+
+
+@pytest.mark.asyncio
+async def test_cache_handles_representative_json_outputs():
+    cache = ResultCache()
+    for sample in REPRESENTATIVE_OUTPUTS:
+        key = str(sample["index"])
+        await cache.put(key, sample)
+        assert await cache.get(key) == sample
+
+

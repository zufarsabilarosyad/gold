+@pytest.mark.asyncio
+async def test_cache_hit_emits_lifecycle_event() -> None:
+    """Verify that cache hit triggers STEP_CACHE_HIT with the required payload fields."""
+    captured_events: list[tuple[Any, dict[str, Any]]] = []
+    hooks = HookRegistry()
+    hooks.register(
+        LifecycleEvent.STEP_CACHE_HIT,
+        lambda event, context, payload: captured_events.append((event, payload)),
+    )
+
+    runner_instance, _ = create_test_runner(hooks=hooks)
+    dag_spec = build_test_dag()
+
+    await runner_instance.run_async(dag_spec)
+    await runner_instance.run_async(dag_spec)
+
+    assert len(captured_events) >= 1
+    event_type, payload = captured_events[0]
+    assert event_type == LifecycleEvent.STEP_CACHE_HIT
+    assert set(payload.keys()) == {"step_id", "cache_key", "output"}
+    assert payload["step_id"] == "work"
+    assert isinstance(payload["cache_key"], str) and len(payload["cache_key"]) > 0
+    assert payload["output"]["call"] == 1

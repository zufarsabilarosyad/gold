+@pytest.mark.asyncio
+async def test_cache_hit_success_payload_marks_cached() -> None:
+    """Verify that STEP_SUCCESS payload reports cached: True on hit and False on execution."""
+    captured_events: list[tuple[Any, dict[str, Any]]] = []
+    hooks = HookRegistry()
+    for event_type in (
+        LifecycleEvent.STEP_START,
+        LifecycleEvent.STEP_CACHE_HIT,
+        LifecycleEvent.STEP_SUCCESS,
+    ):
+        hooks.register(
+            event_type,
+            lambda event, context, payload: captured_events.append((event, payload)),
+        )
+
+    runner_instance, _ = create_test_runner(hooks=hooks)
+    dag_spec = build_test_dag()
+
+    await runner_instance.run_async(dag_spec)
+    executed_event_types = [ev for ev, _ in captured_events]
+    assert LifecycleEvent.STEP_START in executed_event_types
+    executed_payload = captured_events[-1][1]
+    assert set(executed_payload.keys()) == {"step_id", "output", "cached"}
+    assert executed_payload["step_id"] == "work"
+    assert executed_payload["output"] == {"call": 1, "input": None, "step_id": "work"}
+    assert executed_payload["cached"] is False
+
+    captured_events.clear()
+    await runner_instance.run_async(dag_spec)
+
+    dispatched_events = [ev for ev, _ in captured_events]
+    assert LifecycleEvent.STEP_START not in dispatched_events
+    assert dispatched_events == [
+        LifecycleEvent.STEP_CACHE_HIT,
+        LifecycleEvent.STEP_SUCCESS,
+    ]
+    hit_payload = captured_events[0][1]
+    assert set(hit_payload.keys()) == {"step_id", "cache_key", "output"}
+    assert hit_payload["step_id"] == "work"
+    assert hit_payload["output"] == {"call": 1, "input": None, "step_id": "work"}
+
+    success_payload = captured_events[1][1]
+    assert set(success_payload.keys()) == {"step_id", "output", "cached"}
+    assert success_payload["step_id"] == "work"
+    assert success_payload["output"] == {"call": 1, "input": None, "step_id": "work"}
+    assert success_payload["cached"] is True
+

+"""Contract coverage for reusable workflow step results.
+
+This suite verifies that deterministic workflow steps can safely reuse
+prior successful execution outputs while ensuring data isolation and
+correct lifecycle hook dispatching.
+"""
+
+import asyncio
+from typing import Any
+
+import pytest
+
+from basalt.core.dag.ast import DAGSpec, ExecutorType, MemoizationPolicySpec, StepSpec
+from basalt.core.engine.hooks import HookRegistry, LifecycleEvent
+from basalt.core.engine.memoization import ResultCache
+from basalt.core.engine.runner import WorkflowRunner
+from basalt.core.executors.base import BaseExecutor
+from basalt.core.executors.pool import ExecutorFactory, WorkerPool
+
+
+class CallCountingExecutor(BaseExecutor):
+    """Custom step executor tracking execution count and returning inputs."""
+
+    def __init__(self) -> None:
+        super().__init__("custom")
+        self.calls: int = 0
+
+    async def execute(self, step: StepSpec, context: Any) -> dict[str, Any]:
+        self.calls += 1
+        return {
+            "call": self.calls,
+            "input": context.inputs.get("value"),
+            "step_id": step.id,
+        }
+
+
+def create_test_runner(
+    executor: BaseExecutor | None = None,
+    hooks: HookRegistry | None = None,
+    cache: ResultCache | None = None,
+) -> tuple[WorkflowRunner, CallCountingExecutor]:
+    """Build a test workflow runner with an isolated executor factory."""
+    counting_executor = executor or CallCountingExecutor()
+    factory = ExecutorFactory()
+    factory.register("custom", counting_executor)
+    factory.register("subprocess", counting_executor)
+    factory.register("python_inline", counting_executor)
+    worker_pool = WorkerPool(factory=factory)
+    runner_instance = WorkflowRunner(
+        worker_pool=worker_pool,
+        hook_registry=hooks or HookRegistry(),
+        result_cache=cache,
+    )
+    return runner_instance, counting_executor
+
+
+def build_test_dag(
+    policy: MemoizationPolicySpec | None = None,
+    include_dependent_step: bool = False,
+    cache_key: str | None = None,
+) -> DAGSpec:
+    """Construct a minimal DAG specification for memoization testing."""
+    first_step = StepSpec(
+        id="work",
+        executor_type=ExecutorType.CUSTOM,
+        memoization=policy or MemoizationPolicySpec(enabled=True, key=cache_key),
+    )
+    steps = [first_step]
+    if include_dependent_step:
+        steps.append(
+            StepSpec(
+                id="after",
+                executor_type=ExecutorType.CUSTOM,
+                depends_on=["work"],
+            )
+        )
+    return DAGSpec(id="memo_dag", steps=steps)
+
+
+def test_memo_policy_defaults_disabled() -> None:
+    """Verify that memoization is disabled by default with standard defaults."""
+    policy = MemoizationPolicySpec()
+    assert policy.enabled is False
+    assert policy.key is None
+    assert policy.ttl_seconds is None
+    assert policy.include_inputs is True
+
+
+def test_memo_policy_rejects_nonpositive_ttl() -> None:
+    """Verify that zero or negative TTL seconds values are rejected."""
+    with pytest.raises(ValueError):
+        MemoizationPolicySpec(enabled=True, ttl_seconds=0)
+    with pytest.raises(ValueError):
+        MemoizationPolicySpec(enabled=True, ttl_seconds=-1.0)
+    with pytest.raises(ValueError):
+        MemoizationPolicySpec(enabled=True, ttl_seconds=-0.001)
+
+
+def test_lifecycle_event_step_cache_hit_value() -> None:
+    """Verify that LifecycleEvent.STEP_CACHE_HIT has the exact string enum value."""
+    assert LifecycleEvent.STEP_CACHE_HIT == "step_cache_hit"
+    assert LifecycleEvent.STEP_CACHE_HIT.value == "step_cache_hit"
+    assert LifecycleEvent("step_cache_hit") is LifecycleEvent.STEP_CACHE_HIT
+

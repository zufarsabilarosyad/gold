+@pytest.mark.asyncio
+async def test_result_cache_diverse_data_types() -> None:
+    """Verify that diverse JSON-compatible primitive types serialize correctly."""
+    cache = ResultCache()
+    payload = {
+        "string_val": "hello world",
+        "int_val": 42,
+        "float_val": 3.14159,
+        "bool_val": True,
+        "none_val": None,
+        "list_val": [1, "two", 3.0, False],
+        "nested_dict": {"sub": "data"},
+    }
+
+    await cache.put("diverse_key", payload)
+    result = await cache.get("diverse_key")
+
+    assert result == payload
+    assert result["nested_dict"] is not payload["nested_dict"]
+    assert result["list_val"] is not payload["list_val"]
+

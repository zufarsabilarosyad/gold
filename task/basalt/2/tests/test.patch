+"""Additional contract coverage for the public ResultCache surface."""
+
+import asyncio
+import pytest
+
+from basalt.core.engine.memoization import ResultCache
+
+
+@pytest.mark.asyncio
+async def test_keys_only_lists_live_entries():
+    cache = ResultCache()
+    await cache.put("one", {"result": 1})
+    await cache.put("two", {"result": 2}, ttl_seconds=0.001)
+    await asyncio.sleep(0.01)
+    assert await cache.keys() == ["one"]
+
+
+@pytest.mark.asyncio
+async def test_invalidate_missing_key_reports_false():
+    cache = ResultCache()
+    assert await cache.invalidate("missing") is False
+
+
+@pytest.mark.asyncio
+async def test_clear_leaves_zero_entries():
+    cache = ResultCache()
+    await cache.put("one", {})
+    await cache.put("two", {})
+    cleared = await cache.clear()
+    assert cleared == 2
+    assert await cache.stats() == {"entries": 0, "hits": 0, "misses": 0}
+    assert await cache.keys() == []

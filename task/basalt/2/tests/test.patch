+@pytest.mark.asyncio
+async def test_multi_step_workflow_partial_memoization() -> None:
+    """Verify pipeline execution where some steps are memoized and others are not."""
+    worker = DedicatedWorker()
+    factory = ExecutorFactory()
+    factory.register("custom", worker)
+    worker_pool = WorkerPool(factory=factory)
+    runner = WorkflowRunner(worker_pool=worker_pool, hook_registry=HookRegistry())
+
+    dag_spec = DAGSpec(
+        id="mixed_dag",
+        steps=[
+            StepSpec(
+                id="cached_step",
+                executor_type=ExecutorType.CUSTOM,
+                memoization=MemoizationPolicySpec(enabled=True, key="fixed_cache"),
+            ),
+            StepSpec(
+                id="fresh_step",
+                executor_type=ExecutorType.CUSTOM,
+                memoization=MemoizationPolicySpec(enabled=False),
+            ),
+        ],
+    )
+
+    await runner.run_async(dag_spec)
+    assert worker.invocation_count == 2
+
+    await runner.run_async(dag_spec)
+    # cached_step reuses output (0 calls), fresh_step runs again (1 call)
+    assert worker.invocation_count == 3
+

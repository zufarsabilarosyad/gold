index 0000000..e1a462f
--- /dev/null
+++ b/tests/test_run_event_timeline.py
@@ -0,0 +1,363 @@
+"""Behavioral coverage for standalone run event timelines."""
+
+from datetime import UTC, datetime, timedelta, timezone
+
+import pytest
+
+from basalt.core.engine import (
+    RunEvent,
+    RunEventPage,
+    RunEventSummary,
+    RunEventType,
+    RunTimeline,
+)
+
+
+def utc(second: int = 0) -> datetime:
+    return datetime(2025, 1, 1, 12, 0, second, tzinfo=UTC)
+
+
+def populated_timeline() -> RunTimeline:
+    timeline = RunTimeline("run-1", "dag-1")
+    timeline.append(
+        RunEventType("workflow_started"), data={"inputs": {"region": "eu"}}, timestamp=utc()
+    )
+    timeline.append("step_started", step_id="extract", timestamp=utc(1))
+    timeline.append(
+        "step_succeeded", step_id="extract", data={"output": {"rows": 4}}, timestamp=utc(2)
+    )
+    timeline.append("step_started", step_id="load", timestamp=utc(3))
+    timeline.append("step_failed", step_id="load", data={"error": "disk full"}, timestamp=utc(4))
+    timeline.append(
+        "workflow_failed", data={"error": "disk full", "state": "FAILED"}, timestamp=utc(5)
+    )
+    return timeline
+
+
+@pytest.mark.parametrize(
+    ("event_type", "workflow", "step", "terminal"),
+    [
+        (RunEventType("workflow_started"), True, False, False),
+        (RunEventType("workflow_succeeded"), True, False, True),
+        (RunEventType("workflow_failed"), True, False, True),
+        (RunEventType("workflow_cancelled"), True, False, True),
+        (RunEventType("step_started"), False, True, False),
+        (RunEventType("step_succeeded"), False, True, False),
+        (RunEventType("step_failed"), False, True, False),
+        (RunEventType("step_skipped"), False, True, False),
+    ],
+)
+def test_event_type_classification(event_type, workflow, step, terminal):
+    assert event_type.is_workflow_event is workflow
+    assert event_type.is_step_event is step
+    assert event_type.is_terminal is terminal
+
+
+def test_run_event_accepts_enum_and_string_type():
+    enum_event = RunEvent(
+        sequence=1,
+        run_id="r",
+        dag_id="d",
+        type=RunEventType("workflow_started"),
+        timestamp=utc(),
+    )
+    string_event = RunEvent(
+        sequence=2, run_id="r", dag_id="d", type="step_started", step_id="s", timestamp=utc(1)
+    )
+    assert enum_event.type.value == "workflow_started"
+    assert string_event.type.value == "step_started"
+
+
+def test_run_event_rejects_nonpositive_sequence():
+    with pytest.raises(ValueError):
+        RunEvent(sequence=0, run_id="r", dag_id="d", type="workflow_started", timestamp=utc())
+
+
+def test_run_event_rejects_naive_timestamp():
+    with pytest.raises(ValueError):
+        RunEvent(
+            sequence=1,
+            run_id="r",
+            dag_id="d",
+            type="workflow_started",
+            timestamp=datetime(2025, 1, 1),
+        )
+
+
+def test_run_event_normalizes_offset_timestamp_to_utc():
+    value = datetime(2025, 1, 1, 15, tzinfo=timezone(timedelta(hours=3)))
+    event = RunEvent(sequence=1, run_id="r", dag_id="d", type="workflow_started", timestamp=value)
+    assert event.timestamp == datetime(2025, 1, 1, 12, tzinfo=UTC)
+    assert event.timestamp.tzinfo is UTC
+
+
+def test_new_timeline_is_empty_and_identified():
+    timeline = RunTimeline("run-1", "dag-1")
+    assert timeline.run_id == "run-1"
+    assert timeline.dag_id == "dag-1"
+    assert timeline.snapshot() == []
+
+
+@pytest.mark.parametrize(("run_id", "dag_id"), [("", "dag"), ("run", "")])
+def test_timeline_requires_both_identifiers(run_id, dag_id):
+    with pytest.raises(ValueError):
+        RunTimeline(run_id, dag_id)
+
+
+def test_append_assigns_contiguous_sequence_and_identity():
+    timeline = RunTimeline("run-a", "dag-a")
+    first = timeline.append(type="workflow_started", timestamp=utc())
+    second = timeline.append("step_started", step_id="one", timestamp=utc(1))
+    assert [first.sequence, second.sequence] == [1, 2]
+    assert {first.run_id, second.run_id} == {"run-a"}
+    assert {first.dag_id, second.dag_id} == {"dag-a"}
+
+
+def test_append_defaults_to_aware_utc_timestamp():
+    before = datetime.now(UTC)
+    event = RunTimeline("r", "d").append("workflow_started")
+    after = datetime.now(UTC)
+    assert event.timestamp.tzinfo is UTC
+    assert before <= event.timestamp <= after
+
+
+def test_append_copies_input_data():
+    timeline = RunTimeline("r", "d")
+    data = {"nested": {"value": 1}}
+    event = timeline.append("workflow_started", data=data, timestamp=utc())
+    data["nested"]["value"] = 2
+    event.data["nested"]["value"] = 3
+    assert timeline.snapshot()[0].data["nested"]["value"] == 1
+
+
+def test_snapshot_is_deeply_isolated():
+    timeline = populated_timeline()
+    first = timeline.snapshot()
+    first[0].data["inputs"]["region"] = "changed"
+    second = timeline.snapshot()
+    assert second[0].data["inputs"]["region"] == "eu"
+
+
+def test_restore_accepts_event_dictionaries():
+    original = populated_timeline()
+    payload = [
+        {
+            "sequence": event.sequence,
+            "run_id": event.run_id,
+            "dag_id": event.dag_id,
+            "type": event.type.value,
+            "timestamp": event.timestamp,
+            "step_id": event.step_id,
+            "data": event.data,
+        }
+        for event in original.snapshot()
+    ]
+    restored = RunTimeline.restore("run-1", "dag-1", payload)
+    assert restored.snapshot() == original.snapshot()
+    assert restored.append("workflow_cancelled", timestamp=utc(6)).sequence == 7
+
+
+def test_restore_copies_event_instances():
+    events = populated_timeline().snapshot()
+    restored = RunTimeline.restore("run-1", "dag-1", events)
+    events[0].data["inputs"]["region"] = "changed"
+    assert restored.snapshot()[0].data["inputs"]["region"] == "eu"
+
+
+def test_restore_rejects_noncontiguous_sequences():
+    events = populated_timeline().snapshot()
+    events[2].sequence = 9
+    with pytest.raises(ValueError):
+        RunTimeline.restore("run-1", "dag-1", events)
+
+
+@pytest.mark.parametrize(("field", "value"), [("run_id", "other"), ("dag_id", "other")])
+def test_restore_rejects_mismatched_identity(field, value):
+    events = populated_timeline().snapshot()
+    setattr(events[0], field, value)
+    with pytest.raises(ValueError):
+        RunTimeline.restore("run-1", "dag-1", events)
+
+
+def test_restore_rejects_backwards_timestamps():
+    events = populated_timeline().snapshot()
+    events[2].timestamp = utc(0)
+    with pytest.raises(ValueError):
+        RunTimeline.restore("run-1", "dag-1", events)
+
+
+def test_query_returns_complete_default_page():
+    page = populated_timeline().query()
+    assert isinstance(page, RunEventPage)
+    assert page.run_id == "run-1"
+    assert [event.sequence for event in page.events] == [1, 2, 3, 4, 5, 6]
+    assert page.next_after_sequence == 6
+    assert page.has_more is False
+
+
+def test_query_accepts_single_string_or_enum_filter():
+    timeline = populated_timeline()
+    strings = timeline.query(event_types="step_started")
+    enums = timeline.query(event_types=RunEventType("step_started"))
+    assert strings == enums
+    assert [event.step_id for event in strings.events] == ["extract", "load"]
+
+
+def test_query_accepts_multiple_event_types():
+    page = populated_timeline().query(event_types=["step_succeeded", RunEventType("step_failed")])
+    assert [(event.type.value, event.step_id) for event in page.events] == [
+        ("step_succeeded", "extract"),
+        ("step_failed", "load"),
+    ]
+
+
+def test_query_applies_exact_step_filter():
+    page = populated_timeline().query(step_id="extract")
+    assert [event.sequence for event in page.events] == [2, 3]
+    assert {event.step_id for event in page.events} == {"extract"}
+
+
+def test_query_filters_before_applying_limit():
+    page = populated_timeline().query(event_types=["step_started", "step_failed"], limit=2)
+    assert [event.sequence for event in page.events] == [2, 4]
+    assert page.next_after_sequence == 4
+    assert page.has_more is True
+
+
+def test_query_cursor_is_exclusive():
+    page = populated_timeline().query(after_sequence=3, limit=2)
+    assert [event.sequence for event in page.events] == [4, 5]
+    assert page.next_after_sequence == 5
+    assert page.has_more is True
+
+
+def test_empty_query_retains_requested_cursor():
+    page = populated_timeline().query(event_types="step_skipped", after_sequence=4)
+    assert page.events == []
+    assert page.next_after_sequence == 4
+    assert page.has_more is False
+
+
+@pytest.mark.parametrize("kwargs", [{"after_sequence": -1}, {"limit": 0}, {"limit": 201}])
+def test_query_rejects_invalid_paging(kwargs):
+    with pytest.raises(ValueError):
+        populated_timeline().query(**kwargs)
+
+
+def test_query_result_is_deeply_isolated():
+    timeline = populated_timeline()
+    page = timeline.query(limit=1)
+    page.events[0].data["inputs"]["region"] = "changed"
+    assert timeline.query(limit=1).events[0].data["inputs"]["region"] == "eu"
+
+
+def test_query_with_empty_type_collection_returns_no_events():
+    page = populated_timeline().query(event_types=[])
+    assert page.events == []
+    assert page.next_after_sequence == 0
+    assert page.has_more is False
+
+
+def test_query_with_unknown_step_returns_no_events():
+    page = populated_timeline().query(step_id="missing", after_sequence=2)
+    assert page.events == []
+    assert page.next_after_sequence == 2
+    assert page.has_more is False
+
+
+def test_query_accepts_largest_permitted_limit():
+    page = populated_timeline().query(limit=200)
+    assert [event.sequence for event in page.events] == [1, 2, 3, 4, 5, 6]
+    assert page.has_more is False
+
+
+def test_query_cursor_past_last_event_returns_empty_page():
+    page = populated_timeline().query(after_sequence=100)
+    assert page.events == []
+    assert page.next_after_sequence == 100
+    assert page.has_more is False
+
+
+def test_query_combines_type_step_and_cursor_filters():
+    page = populated_timeline().query(
+        event_types=["step_started", "step_succeeded"],
+        step_id="extract",
+        after_sequence=2,
+        limit=10,
+    )
+    assert [event.sequence for event in page.events] == [3]
+    assert page.events[0].type.value == "step_succeeded"
+    assert page.events[0].step_id == "extract"
+
+
+def test_empty_summary_has_neutral_values():
+    summary = RunTimeline("empty", "dag").summarize()
+    assert isinstance(summary, RunEventSummary)
+    assert summary.run_id == "empty"
+    assert summary.total_events == 0
+    assert summary.first_timestamp is None
+    assert summary.last_timestamp is None
+    assert summary.terminal_type is None
+    assert summary.elapsed_ms is None
+    assert summary.event_counts == {}
+    assert summary.step_counts == {}
+    assert summary.has_failures() is False
+    assert summary.has_skips() is False
+
+
+def test_summary_counts_events_and_steps():
+    summary = populated_timeline().summarize()
+    assert summary.total_events == 6
+    assert summary.event_counts[RunEventType("workflow_started")] == 1
+    assert summary.event_counts[RunEventType("step_started")] == 2
+    assert summary.event_counts[RunEventType("step_succeeded")] == 1
+    assert summary.event_counts[RunEventType("step_failed")] == 1
+    assert summary.event_counts[RunEventType("workflow_failed")] == 1
+    assert summary.step_counts == {"extract": 2, "load": 2}
+
+
+def test_summary_reports_step_lists_and_terminal_type():
+    summary = populated_timeline().summarize()
+    assert summary.started_step_ids == ["extract", "load"]
+    assert summary.succeeded_step_ids == ["extract"]
+    assert summary.failed_step_ids == ["load"]
+    assert summary.skipped_step_ids == []
+    assert summary.terminal_type.value == "workflow_failed"
+    assert summary.has_failures() is True
+    assert summary.has_skips() is False
+
+
+def test_summary_uses_first_and_last_event_boundaries():
+    summary = populated_timeline().summarize()
+    assert summary.first_timestamp == utc(0)
+    assert summary.last_timestamp == utc(5)
+    assert summary.elapsed_ms == 5000.0
+
+
+def test_summary_reports_skipped_steps_in_observation_order():
+    timeline = RunTimeline("run-skip", "dag")
+    timeline.append("workflow_started", timestamp=utc())
+    timeline.append("step_skipped", step_id="beta", timestamp=utc(1))
+    timeline.append("step_skipped", step_id="alpha", timestamp=utc(2))
+    timeline.append("workflow_succeeded", timestamp=utc(3))
+
+    summary = timeline.summarize()
+    assert summary.skipped_step_ids == ["beta", "alpha"]
+    assert summary.step_counts == {"beta": 1, "alpha": 1}
+    assert summary.event_counts[RunEventType("workflow_started")] == 1
+    assert summary.event_counts[RunEventType("step_skipped")] == 2
+    assert summary.event_counts[RunEventType("workflow_succeeded")] == 1
+    assert summary.has_skips() is True
+    assert summary.has_failures() is False
+
+
+def test_summary_uses_latest_terminal_event():
+    timeline = RunTimeline("run-terminal", "dag")
+    timeline.append("workflow_started", timestamp=utc())
+    timeline.append("workflow_failed", timestamp=utc(1))
+    timeline.append("workflow_cancelled", timestamp=utc(2))
+
+    summary = timeline.summarize()
+    assert summary.terminal_type.value == "workflow_cancelled"
+    assert summary.first_timestamp == utc()
+    assert summary.last_timestamp == utc(2)
+    assert summary.elapsed_ms == 2000.0

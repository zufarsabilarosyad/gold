@@ -0,0 +1,26 @@
+"""Defensive-copy helpers shared by timeline operations."""
+
+from __future__ import annotations
+
+import copy
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+from basalt.core.engine.timeline_types import RunEvent
+
+
+def copy_data(data: Mapping[str, Any] | None) -> dict[str, Any]:
+    """Copy caller-owned event data into a plain independent dictionary."""
+    if data is None:
+        return {}
+    return copy.deepcopy(dict(data))
+
+
+def copy_event(event: RunEvent) -> RunEvent:
+    """Create an independent event including all nested data values."""
+    return event.model_copy(deep=True)
+
+
+def copy_events(events: Iterable[RunEvent]) -> list[RunEvent]:
+    """Copy an event iterable while preserving its current order."""
+    return [copy_event(event) for event in events]

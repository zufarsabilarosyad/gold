+"""Append-only, in-memory workflow run event timeline."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from datetime import UTC, datetime
+from typing import Any
+
+from basalt.core.engine.timeline_copy import copy_data, copy_event, copy_events
+from basalt.core.engine.timeline_query import query_events
+from basalt.core.engine.timeline_restore import restore_events
+from basalt.core.engine.timeline_summary import summarize_events
+from basalt.core.engine.timeline_types import (
+    RunEvent,
+    RunEventPage,
+    RunEventSummary,
+    RunEventType,
+)
+from basalt.core.engine.timeline_validation import require_identifier
+
+
+class RunTimeline:
+    """Own the ordered event history for one workflow run."""
+
+    def __init__(self, run_id: str, dag_id: str) -> None:
+        self.run_id = require_identifier(run_id, "run_id")
+        self.dag_id = require_identifier(dag_id, "dag_id")
+        self._events: list[RunEvent] = []
+
+    @classmethod
+    def restore(
+        cls,
+        run_id: str,
+        dag_id: str,
+        events: Iterable[RunEvent | dict[str, Any]],
+    ) -> RunTimeline:
+        """Rebuild a timeline from validated event objects or dictionaries.
+
+        Validation is performed before the restored list is exposed. Sequence
+        numbers must be contiguous and one-based, identities must match the
+        requested timeline, and timestamps may not move backwards.
+        """
+        timeline = cls(run_id, dag_id)
+        timeline._events = restore_events(run_id, dag_id, events)
+        return timeline
+
+    def append(
+        self,
+        type: RunEventType | str,
+        *,
+        step_id: str | None = None,
+        data: dict[str, Any] | None = None,
+        timestamp: datetime | None = None,
+    ) -> RunEvent:
+        """Append an event with the next sequence and return an isolated copy."""
+        event = RunEvent(
+            sequence=len(self._events) + 1,
+            run_id=self.run_id,
+            dag_id=self.dag_id,
+            type=type,
+            timestamp=timestamp or datetime.now(UTC),
+            step_id=step_id,
+            data=copy_data(data),
+        )
+        self._events.append(event)
+        return copy_event(event)
+
+    def snapshot(self) -> list[RunEvent]:
+        """Return a deep copy of all events in sequence order."""
+        return copy_events(self._events)
+
+    def query(
+        self,
+        *,
+        event_types: RunEventType | str | Iterable[RunEventType | str] | None = None,
+        step_id: str | None = None,
+        after_sequence: int = 0,
+        limit: int = 100,
+    ) -> RunEventPage:
+        """Filter and page this timeline without exposing mutable state."""
+        return query_events(
+            self.run_id,
+            self._events,
+            event_types=event_types,
+            step_id=step_id,
+            after_sequence=after_sequence,
+            limit=limit,
+        )
+
+    def summarize(self) -> RunEventSummary:
+        """Return counts, step outcomes, and time boundaries for this run."""
+        return summarize_events(self.run_id, self._events)
diff --git a/src/basalt/core/engine/timeline_types.py b/src/basalt/core/engine/timeline_types.py

@@ -0,0 +1,58 @@
+"""Validation used when restoring persisted timeline snapshots."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from datetime import datetime
+from typing import Any
+
+from basalt.core.engine.timeline_copy import copy_event
+from basalt.core.engine.timeline_types import RunEvent
+
+
+def coerce_event(value: RunEvent | dict[str, Any]) -> RunEvent:
+    """Validate a dictionary or retain an already validated event value."""
+    if isinstance(value, RunEvent):
+        return value
+    return RunEvent.model_validate(value)
+
+
+def validate_position(event: RunEvent, expected_sequence: int) -> None:
+    """Require the next contiguous, one-based sequence number."""
+    if event.sequence != expected_sequence:
+        raise ValueError("event sequences must be contiguous and one-based")
+
+
+def validate_identity(event: RunEvent, run_id: str, dag_id: str) -> None:
+    """Require every event to belong to its containing run timeline."""
+    if event.run_id != run_id or event.dag_id != dag_id:
+        raise ValueError("event identity does not match the timeline")
+
+
+def validate_timestamp_order(
+    event: RunEvent,
+    previous_timestamp: datetime | None,
+) -> None:
+    """Require timestamps to retain their observation order."""
+    if previous_timestamp is not None and event.timestamp < previous_timestamp:
+        raise ValueError("event timestamps must not move backwards")
+
+
+def restore_events(
+    run_id: str,
+    dag_id: str,
+    events: Iterable[RunEvent | dict[str, Any]],
+) -> list[RunEvent]:
+    """Validate and defensively copy a complete restored event stream."""
+    restored: list[RunEvent] = []
+    previous_timestamp: datetime | None = None
+
+    for expected_sequence, value in enumerate(events, start=1):
+        event = coerce_event(value)
+        validate_position(event, expected_sequence)
+        validate_identity(event, run_id, dag_id)
+        validate_timestamp_order(event, previous_timestamp)
+        restored.append(copy_event(event))
+        previous_timestamp = event.timestamp
+
+    return restored

@@ -0,0 +1,22 @@
+"""Input validation shared by timeline construction and querying."""
+
+
+def require_identifier(value: str, name: str) -> str:
+    """Return a nonempty identifier or reject it with ``ValueError``."""
+    if not value:
+        raise ValueError(f"{name} must not be empty")
+    return value
+
+
+def require_cursor(after_sequence: int) -> int:
+    """Return a valid nonnegative exclusive sequence cursor."""
+    if after_sequence < 0:
+        raise ValueError("after_sequence must be nonnegative")
+    return after_sequence
+
+
+def require_limit(limit: int) -> int:
+    """Return a page size within the public inclusive bounds."""
+    if not 1 <= limit <= 200:
+        raise ValueError("limit must be between 1 and 200")
+    return limit


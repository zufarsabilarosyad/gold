+@pytest.mark.asyncio
+async def test_engine_retry_persists_checkpoint_lineage_in_sqlite(tmp_path):
+    calls = {"root": 0, "work": 0}
+
+    def root():
+        calls["root"] += 1
+        return {"seed": 4}
+
+    def work():
+        calls["work"] += 1
+        if calls["work"] == 1:
+            raise RuntimeError("retry later")
+        return {"done": True}
+
+    register_python_callable("persist_resume_root", root)
+    register_python_callable("persist_resume_work", work)
+    dag = DAGSpec(
+        id="persist_resume_dag",
+        steps=[
+            StepSpec(id="root", executor_type=ExecutorType.PYTHON_INLINE, callable_name="persist_resume_root"),
+            StepSpec(
+                id="work",
+                executor_type=ExecutorType.PYTHON_INLINE,
+                callable_name="persist_resume_work",
+                depends_on=["root"],
+            ),
+        ],
+    )
+    engine = BasaltEngine(
+        EngineConfig(
+            db_url=f"sqlite+aiosqlite:///{tmp_path / 'resume.db'}",
+            use_memory_storage=False,
+            enable_triggers=False,
+        )
+    )
+    await engine.start()
+    await engine.register_dag(dag)
+    first = await engine.run_dag(dag.id, run_id="persist-first")
+    resumed = await engine.retry_run(first.run_id, new_run_id="persist-resumed")
+    loaded = await engine.get_run_result(resumed.run_id)
+
+    assert loaded is not None
+    assert loaded.parent_run_id == "persist-first"
+    assert loaded.resume_depth == 1
+    assert loaded.reused_step_ids == ["root"]
+    assert loaded.step_attempts == {"root": 1, "work": 2}
+    assert [entry["attempt"] for entry in loaded.step_attempt_history["work"]] == [1, 2]
+    assert calls == {"root": 1, "work": 2}
+    original = await engine.get_run_result("persist-first")
+    assert original is not None and original.state == WorkflowState.FAILED
+    await engine.stop()

+@pytest.mark.asyncio
+async def test_multi_generation_resume_tracks_depth_and_cumulative_checkpoint(tmp_path):
+    calls = {"root": 0, "work": 0}
+
+    def root():
+        calls["root"] += 1
+        return {"seed": 5}
+
+    def work():
+        calls["work"] += 1
+        if calls["work"] < 3:
+            raise RuntimeError(f"failure {calls['work']}")
+        return {"finished": True}
+
+    register_python_callable("chain_root", root)
+    register_python_callable("chain_work", work)
+    engine = BasaltEngine(
+        EngineConfig(
+            db_url=f"sqlite+aiosqlite:///{tmp_path / 'resume-chain.db'}",
+            use_memory_storage=False,
+            enable_triggers=False,
+        )
+    )
+    await engine.start()
+    await engine.register_dag(
+        DAGSpec(
+            id="resume_chain_dag",
+            steps=[
+                StepSpec(id="root", executor_type=ExecutorType.PYTHON_INLINE, callable_name="chain_root"),
+                StepSpec(
+                    id="work",
+                    executor_type=ExecutorType.PYTHON_INLINE,
+                    callable_name="chain_work",
+                    depends_on=["root"],
+                ),
+            ],
+        )
+    )
+
+    first = await engine.run_dag("resume_chain_dag", run_id="chain-0")
+    second = await engine.retry_run(first.run_id, new_run_id="chain-1")
+    third = await engine.retry_run(second.run_id, new_run_id="chain-2")
+    loaded = await engine.get_run_result("chain-2")
+
+    assert [first.state, second.state, third.state] == [
+        WorkflowState.FAILED,
+        WorkflowState.FAILED,
+        WorkflowState.COMPLETED,
+    ]
+    assert loaded is not None
+    assert loaded.parent_run_id == "chain-1"
+    assert loaded.resume_depth == 2
+    assert loaded.reused_step_ids == ["root"]
+    assert loaded.step_attempts == {"root": 1, "work": 3}
+    assert [entry["attempt"] for entry in loaded.step_attempt_history["work"]] == [1, 2, 3]
+    assert calls == {"root": 1, "work": 3}
+    await engine.stop()

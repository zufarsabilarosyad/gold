+        await WorkflowRunner().run_async(dag, resume_from=successful)
+
+    for index, allowed_state in enumerate(
+        (WorkflowState.FAILED, WorkflowState.TIMEOUT, WorkflowState.CANCELLED), start=1
+    ):
+        checkpoint = successful.model_copy(update={"state": allowed_state})
+        resumed = await WorkflowRunner().run_async(
+            dag, run_id=f"allowed-resume-{index}", resume_from=checkpoint
+        )
+        assert resumed.state == WorkflowState.COMPLETED
+        assert resumed.parent_run_id == successful.run_id
+
+    failed = successful.model_copy(
+        update={"state": WorkflowState.FAILED, "dag_id": "another_dag"}
+    )
+    with pytest.raises(ValueError):
+        await WorkflowRunner().run_async(dag, resume_from=failed)
+
+    stale = successful.model_copy(
+        update={
+            "state": WorkflowState.FAILED,
+            "step_states": {"removed": StepState.COMPLETED},
+        }
+    )
+    with pytest.raises(ValueError):
+        await WorkflowRunner().run_async(dag, resume_from=stale)
+
+    expanded_dag = dag.model_copy(
+        update={
+            "steps": dag.steps
+            + [
+                StepSpec(
+                    id="added",
+                    executor_type=ExecutorType.PYTHON_INLINE,
+                    callable_name="resume_ok",
+                )
+            ]
+        }
+    )
+    failed_for_original = successful.model_copy(update={"state": WorkflowState.FAILED})
+    with pytest.raises(ValueError):
+        await WorkflowRunner().run_async(expanded_dag, resume_from=failed_for_original)
+

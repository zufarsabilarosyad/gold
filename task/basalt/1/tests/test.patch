+def test_cli_retry_resumes_checkpoint_and_renders_lineage(tmp_path):
+    import json
+
+    from click.testing import CliRunner
+
+    from basalt.cli.main import cli
+
+    calls = {"root": 0, "work": 0}
+
+    def root():
+        calls["root"] += 1
+        return {"seed": 1}
+
+    def work():
+        calls["work"] += 1
+        if calls["work"] == 1:
+            raise RuntimeError("cli retry")
+        return {"done": True}
+
+    register_python_callable("cli_resume_root", root)
+    register_python_callable("cli_resume_work", work)
+    dag_file = tmp_path / "resume.yaml"
+    dag_file.write_text(
+        """
+id: cli_resume_dag
+steps:
+  - id: root
+    executor_type: python_inline
+    callable_name: cli_resume_root
+  - id: work
+    executor_type: python_inline
+    callable_name: cli_resume_work
+    depends_on: [root]
+"""
+    )
+    db_url = f"sqlite+aiosqlite:///{tmp_path / 'resume-cli.db'}"
+    cli_runner = CliRunner()
+    started = cli_runner.invoke(
+        cli,
+        ["run", "start", str(dag_file), "--run-id", "cli-resume-first", "--db-url", db_url],
+    )
+    assert started.exit_code == 0
+
+    retried = cli_runner.invoke(
+        cli, ["run", "retry", "cli-resume-first", "--db-url", db_url, "--format", "json"]
+    )
+    assert retried.exit_code == 0
+    payload = json.loads(retried.output[retried.output.index("{") :])
+    assert payload["state"] == "COMPLETED"
+    assert payload["parent_run_id"] == "cli-resume-first"
+    assert payload["resume_depth"] == 1
+    assert payload["reused_step_ids"] == ["root"]
+    assert payload["step_attempts"]["work"] == 2
+    assert calls == {"root": 1, "work": 2}
+    status = cli_runner.invoke(
+        cli, ["run", "status", payload["run_id"], "--db-url", db_url]
+    )
+    assert status.exit_code == 0
+    assert "Resumed From" in status.output and "cli-resume-first" in status.output
+    assert "Resume Depth" in status.output and "1" in status.output
+    assert "Reused Steps" in status.output and "root" in status.output
+

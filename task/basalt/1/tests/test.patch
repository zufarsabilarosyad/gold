+@pytest.mark.asyncio
+async def test_independent_branch_histories_survive_continued_failure():
+    register_failure("history_bad_root")
+    retry_calls: list[int] = []
+
+    def recovers():
+        retry_calls.append(1)
+        if len(retry_calls) == 1:
+            raise RuntimeError("branch transient")
+        return {"recovered": True}
+
+    register_python_callable("history_recovers", recovers)
+    dag = DAGSpec(
+        id="mixed_history_dag",
+        steps=[
+            inline("bad", "history_bad_root", on_failure=OnFailureAction.CONTINUE),
+            StepSpec(
+                id="retrying",
+                executor_type=ExecutorType.PYTHON_INLINE,
+                callable_name="history_recovers",
+                on_failure=OnFailureAction.RETRY,
+                retry_policy={"max_retries": 2, "initial_delay_seconds": 0.001, "jitter": False},
+            ),
+        ],
+    )
+
+    result = await WorkflowRunner().run_async(dag)
+
+    assert result.state == WorkflowState.FAILED
+    assert [item["state"] for item in result.step_attempt_history["retrying"]] == [
+        "RETRYING",
+        "COMPLETED",
+    ]
+    assert result.outputs["retrying"] == {"recovered": True}

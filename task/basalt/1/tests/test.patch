+                executor_type=ExecutorType.PYTHON_INLINE,
+                callable_name="resume_flaky",
+                depends_on=["root"],
+                on_failure=OnFailureAction.CONTINUE,
+            ),
+            StepSpec(
+                id="independent",
+                executor_type=ExecutorType.PYTHON_INLINE,
+                callable_name="resume_independent",
+                depends_on=["root"],
+            ),
+            StepSpec(
+                id="child",
+                executor_type=ExecutorType.PYTHON_INLINE,
+                callable_name="resume_child",
+                depends_on=["flaky"],
